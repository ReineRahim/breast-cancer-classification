        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "# Extract data\n",
        "models = before_after[\"Model\"]\n",
        "baseline_f1 = before_after[\"Baseline F1\"]\n",
        "tuned_f1 = before_after[\"Tuned F1\"]\n",
        "\n",
        "baseline_auc = before_after[\"Baseline AUC\"]\n",
        "tuned_auc = before_after[\"Tuned AUC\"]\n",
        "\n",
        "x = np.arange(len(models))\n",
        "width = 0.35\n",
        "\n",
        "plt.figure(figsize=(12, 5))\n",
        "\n",
        "# --- F1-score chart ---\n",
        "plt.subplot(1, 2, 1)\n",
        "plt.bar(x - width/2, baseline_f1, width, label=\"Baseline F1\")\n",
        "plt.bar(x + width/2, tuned_f1, width, label=\"Tuned F1\")\n",
        "plt.xticks(x, models, rotation=20, ha=\"right\")\n",
        "plt.ylim(0.90, 1.00)\n",
        "plt.title(\"Baseline vs Tuned F1-Score\")\n",
        "plt.ylabel(\"F1 Score\")\n",
        "plt.grid(axis=\"y\", linestyle=\"--\", alpha=0.4)\n",
        "plt.legend()\n",
        "\n",
        "# --- AUC chart ---\n",
        "plt.subplot(1, 2, 2)\n",
        "plt.bar(x - width/2, baseline_auc, width, label=\"Baseline AUC\")\n",
        "plt.bar(x + width/2, tuned_auc, width, label=\"Tuned AUC\")\n",
        "plt.xticks(x, models, rotation=20, ha=\"right\")\n",
        "plt.ylim(0.97, 1.00)\n",
        "plt.title(\"Baseline vs Tuned ROC–AUC\")\n",
        "plt.ylabel(\"AUC Score\")\n",
        "plt.grid(axis=\"y\", linestyle=\"--\", alpha=0.4)\n",
        "plt.legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
